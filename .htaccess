# =============================================================================
# Anđelin Ciklus — Apache Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Compression (mod_deflate)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml text/javascript image/svg+xml

  # Remove browser bugs (older browsers)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html

  # Proxies should deliver the correct content
  Header append Vary User-Agent env=!dont-vary
</IfModule>

# -----------------------------------------------------------------------------
# Caching Headers for Static Assets
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default: 1 week
  ExpiresDefault "access plus 1 week"

  # HTML: 1 hour (revalidated frequently)
  ExpiresByType text/html "access plus 1 hour"

  # CSS & JS: 1 year (cache-bust via ?v= query string)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & favicon: 1 year
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Data files (JSON): 1 day
  ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Add Cache-Control for assets with ?v= query strings
  <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, immutable, max-age=31536000"
  </FilesMatch>

  # HTML: no-cache (check freshness every time)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # JSON data: shorter cache
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# CORS Headers for GitHub API Calls
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Allow the app to fetch from GitHub API
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, If-Match, If-None-Match"

  # Preflight (OPTIONS) caching
  Header set Access-Control-Max-Age "86400"
</IfModule>

# -----------------------------------------------------------------------------
# Redirect HTTP to HTTPS (uncomment if Apache handles SSL termination)
# -----------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -----------------------------------------------------------------------------
# Deny access to dot-files and sensitive metadata
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "^(package\.json|package-lock\.json|yarn\.lock|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>
