{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "no-debugger": "error",
    "no-unused-vars": "warn",
    "no-var": "error",
    "prefer-const": "warn",
    "curly": ["warn", "multi-line"],
    "vars-on-top": "off",
    "no-inner-html": "off",
    "eqeqeq": ["warn", "smart"],
    "no-extra-boolean-cast": "off",
    "no-async-promise-executor": "off",
    "require-await": "off",
    "require-yield": "off",
    "no-return-await": "off"
  },
  "overrides": []
}

